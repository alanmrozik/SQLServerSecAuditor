<Window x:Class="SqlSecAuditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLSecAuditor" Height="800" Width="1000"
        Background="#F4F4F4"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ReportBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCDCDC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="SidebarTabItemStyle" TargetType="TabItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="15,0,15,10"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="#F8F8F8" 
                                BorderBrush="#C0C0C0" 
                                BorderThickness="1" 
                                CornerRadius="2">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              Margin="10,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E5E5" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#A0A0A0" />
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EEEEEE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="5,2">
            <MenuItem Header="_Plik">
                <MenuItem Header="_Zakończ" />
            </MenuItem>
            <MenuItem Header="_Edycja"/>
            <MenuItem Header="_Widok"/>
            <MenuItem Header="P_omoc"/>
        </Menu>

        <TabControl Grid.Row="1" 
            TabStripPlacement="Left" 
            Background="Transparent" 
            BorderThickness="0" 
            Padding="0"
            ItemsSource="{Binding Instances}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="3" Margin="10">
                            <StackPanel IsItemsHost="True" Margin="0,20,0,0"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource SidebarTabItemStyle}">
                    <Setter Property="Header" Value="{Binding ServerName}"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ReportBorderStyle}">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Raport dla: " FontSize="18" FontFamily="Arial" FontWeight="Bold"/>
                                <Label Content="{Binding ServerName}" FontSize="18" FontFamily="Arial" FontWeight="Bold" Foreground="DarkBlue"/>
                            </StackPanel>

                            <!-- Główny scrollbar dla całego okna raportu -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>

                                    <!-- 1. General -->
                                    <!-- 1. General -->
                                    <Expander IsExpanded="True" BorderBrush="#DCDCDC" BorderThickness="1" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <Label Content="General" FontSize="16" FontWeight="Medium" Padding="10,5,0,5"/>
                                        </Expander.Header>

                                        <StackPanel Margin="15">
                                            <!-- TSQL Query Badge / Nagłówek skryptu -->
                                            <TextBlock Text="T-SQL Query Source:" FontWeight="Bold" Foreground="#555555" Margin="0,0,0,5"/>
                                            <Border Background="#F9F9F9" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                                                <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#0066cc" TextWrapping="Wrap">
                SELECT SERVERPROPERTY('MachineName') AS [Server Name], CASE WHEN SERVERPROPERTY('InstanceName') IS NULL THEN 'MSSQLSERVER' ELSE SERVERPROPERTY('InstanceName') END AS [SQL Server Instance Name], SERVERPROPERTY('Edition') AS [Edition], SERVERPROPERTY('ProductVersion') AS [Product Version], SERVERPROPERTY('ProductLevel') AS [Product Level], create_date AS [Uptime], SERVERPROPERTY('ResourceLastUpdateDateTime') AS [Approximately Last Update Date] FROM sys.databases where name = 'tempdb';
                                                </TextBlock>
                                            </Border>

                                            <!-- Rezultat w postaci czystej, czytelnej listy typu Klucz-Wartość -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Style lokalne dla wierszy w tabeli -->
                                                <Grid.Resources>
                                                    <Style TargetType="Label">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#444444"/>
                                                        <Setter Property="Padding" Value="0,6,15,6"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Padding" Value="5,6,5,6"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                    </Style>
                                                </Grid.Resources>

                                                <!-- Wiersz 1: Server Name -->
                                                <Label Grid.Row="0" Grid.Column="0" Content="Server Name:"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GenMachineName}" FontWeight="Medium"/>

                                                <!-- Wiersz 2: SQL Server Instance Name -->
                                                <Label Grid.Row="1" Grid.Column="0" Content="SQL Server Instance Name:"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GenInstanceName}"/>

                                                <!-- Wiersz 3: Edition -->
                                                <Label Grid.Row="2" Grid.Column="0" Content="Edition:"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GenEdition}"/>

                                                <!-- Wiersz 4: Product Version -->
                                                <Label Grid.Row="3" Grid.Column="0" Content="Product Version:"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GenProductVersion}"/>

                                                <!-- Wiersz 5: Product Level -->
                                                <Label Grid.Row="4" Grid.Column="0" Content="Product Level:"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GenProductLevel}"/>

                                                <!-- Wiersz 6: Uptime (tempdb creation) -->
                                                <Label Grid.Row="5" Grid.Column="0" Content="Uptime (Instance Restart):"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GenUptime}"/>

                                                <!-- Wiersz 7: Approximately Last Update Date -->
                                                <Label Grid.Row="6" Grid.Column="0" Content="Approximately Last Update Date:"/>
                                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding GenLastUpdate}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- 2. Authorization and Permissions -->
                                    <Expander IsExpanded="False" BorderBrush="#DCDCDC" BorderThickness="1" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <Label Content="Authorization and Permissions" FontSize="16" FontWeight="Medium" Padding="10,5,0,5"/>
                                        </Expander.Header>
                                        <TextBlock Text="{Binding AuthPermissionsInfo}" Margin="15" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                                    </Expander>

                                    <!-- 3. Authentication and Access Control -->
                                    <Expander IsExpanded="False" BorderBrush="#DCDCDC" BorderThickness="1" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <Label Content="Authentication and Access Control" FontSize="16" FontWeight="Medium" Padding="10,5,0,5"/>
                                        </Expander.Header>
                                        <TextBlock Text="{Binding AuthenAccessControlInfo}" Margin="15" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                                    </Expander>

                                    <!-- 4. Database Security -->
                                    <Expander IsExpanded="False" BorderBrush="#DCDCDC" BorderThickness="1" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <Label Content="Database Security" FontSize="16" FontWeight="Medium" Padding="10,5,0,5"/>
                                        </Expander.Header>
                                        <TextBlock Text="{Binding DatabaseSecurityInfo}" Margin="15" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                                    </Expander>

                                    <!-- 5. Surface Area Reduction -->
                                    <Expander IsExpanded="False" BorderBrush="#DCDCDC" BorderThickness="1" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <Label Content="Surface Area Reduction" FontSize="16" FontWeight="Medium" Padding="10,5,0,5"/>
                                        </Expander.Header>
                                        <TextBlock Text="{Binding SurfaceAreaReductionInfo}" Margin="15" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                                    </Expander>

                                    <!-- 6. Network Connectivity -->
                                    <Expander IsExpanded="False" BorderBrush="#DCDCDC" BorderThickness="1" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <Label Content="Network Connectivity" FontSize="16" FontWeight="Medium" Padding="10,5,0,5"/>
                                        </Expander.Header>
                                        <TextBlock Text="{Binding NetworkConnectivityInfo}" Margin="15" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                                    </Expander>

                                    <!-- 7. High Availability and Disaster Recovery -->
                                    <Expander IsExpanded="False" BorderBrush="#DCDCDC" BorderThickness="1" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <Label Content="High Availability and Disaster Recovery" FontSize="16" FontWeight="Medium" Padding="10,5,0,5"/>
                                        </Expander.Header>
                                        <TextBlock Text="{Binding HighAvailabilityInfo}" Margin="15" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                                    </Expander>

                                    <!-- 8. Maintenance and Integrity -->
                                    <Expander IsExpanded="False" BorderBrush="#DCDCDC" BorderThickness="1" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <Label Content="Maintenance and Integrity" FontSize="16" FontWeight="Medium" Padding="10,5,0,5"/>
                                        </Expander.Header>
                                        <TextBlock Text="{Binding MaintenanceIntegrityInfo}" Margin="15" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>

                            <Button Grid.Row="2" Content="EXPORT" Width="100" Height="30" HorizontalAlignment="Right" Background="White" BorderBrush="#C0C0C0" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>