<Window x:Class="SqlSecAuditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SqlSecAuditor.Views"
        xmlns:conv="clr-namespace:SqlSecAuditor.Converters"
        Title="SQLSecAuditor" Height="800" Width="1000"
        Background="{StaticResource AppWindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:WidthMinusConverter x:Key="WidthMinusConverter" />
        <conv:ScoreToArcConverter x:Key="ScoreToArcConverter" />
        <conv:ScoreToBrushConverter x:Key="ScoreToBrushConverter" />
        <Style x:Key="ReportBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppPanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="12"/>
        </Style>

        <Style x:Key="SectionTabItemStyle" TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,8,12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="tab" Property="Background" Value="#E8F0FF"/><Setter TargetName="tab" Property="BorderBrush" Value="#BFDBFE"/><Setter Property="Foreground" Value="#1D4ED8"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tab" Property="Background" Value="#F1F5F9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopNavigationButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="button" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="button" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="button" Property="Opacity" Value="0.70"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Cursor="Arrow"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" Cursor="Arrow"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom system title bar (Window Chrome) -->
        <Grid Grid.Row="0" Background="{StaticResource AppHeaderBackgroundBrush}" Height="35">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Application title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- Application mark -->
                <Border Width="20" Height="20" CornerRadius="5" Background="#2563EB" Margin="0,0,9,0"><TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="SQLServerSecAuditor" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- System window controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Width="45" FontSize="14" FontFamily="Consolas" Click="Minimize_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AppHeaderHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="[ ]" Width="45" FontSize="12" FontFamily="Consolas" Click="Maximize_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AppHeaderHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="X" Width="45" FontSize="14" FontFamily="Consolas" Click="Close_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E74C3C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <Menu Grid.Row="1" Visibility="Collapsed">
            <MenuItem Header="_File" Padding="10,5">
                <MenuItem Header="_New connection..." Command="{Binding ConnectNewDatabaseCommand}" Foreground="Black"/>
                <Separator/>
                <MenuItem Header="E_xit" Foreground="Black" Click="Close_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" Padding="10,5"/>
            <MenuItem Header="_View" Padding="10,5"/>
            <MenuItem Header="_Help" Padding="10,5"/>
        </Menu>

        <Grid Grid.Row="2" Background="{StaticResource AppWindowBackgroundBrush}">
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Button Content="Audit" Click="ShowAuditTab_Click" Width="96" Height="36" Margin="0,0,8,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNavigationButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TopLevelTabControl}" Value="0"><Setter Property="Background" Value="#E8F0FF"/><Setter Property="Foreground" Value="#1D4ED8"/><Setter Property="BorderBrush" Value="#BFDBFE"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="Snapshots" Click="ShowSnapshotsTab_Click" Width="96" Height="36">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopNavigationButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TopLevelTabControl}" Value="1"><Setter Property="Background" Value="#E8F0FF"/><Setter Property="Foreground" Value="#1D4ED8"/><Setter Property="BorderBrush" Value="#BFDBFE"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            <!-- Top-level tabs: Audit (per instance) and Snapshots (global) -->
            <TabControl x:Name="TopLevelTabControl" Grid.Row="1" SelectedIndex="0" Style="{StaticResource PrimaryTabControlStyle}">
                <!-- === TAB: AUDIT (per instance) === -->
                <TabItem Header="Audit">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" MinWidth="250"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Boczny panel -->
                        <Border x:Name="InstancesSidebar" Grid.Column="0" Background="{StaticResource AppHeaderBackgroundBrush}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="INSTANCES" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" Margin="8,12,0,18" HorizontalAlignment="Left"/>

                                <!-- Convenient connection shortcut in addition to the menu command -->
                                <Button Grid.Row="2" Content="+ New connection"
                                        Command="{Binding ConnectNewDatabaseCommand}"
                                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                                        BorderThickness="0" Padding="10" Cursor="Hand" Margin="0,10,0,10">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1"
                                      Width="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="#34495E"
                                      ShowsPreview="True"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"/>

                        <!-- Taby instancji -->
                        <TabControl Grid.Column="0" Grid.ColumnSpan="3"
                            Tag="{Binding ElementName=InstancesSidebar, Path=ActualWidth}"
                            TabStripPlacement="Left" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="0"
                            ItemsSource="{Binding Instances}"
                            SelectedItem="{Binding SelectedInstance}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- The instance tab strip is layered over the sidebar background -->
                            <StackPanel Grid.Column="0" IsItemsHost="True" Cursor="Arrow" Margin="0,50,0,80"/>

                            <Border Grid.Column="1" Background="{StaticResource AppPanelBackgroundBrush}" BorderBrush="{StaticResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="15" Padding="10">
                                <ContentPresenter ContentSource="SelectedContent" Cursor="Arrow" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Height" Value="45"/>
                        <Setter Property="Margin" Value="10,0,10,5"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Background="#315E8B" BorderThickness="0" CornerRadius="7">
                                        <ContentPresenter x:Name="ContentSite"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          ContentSource="Header"
                                                          Margin="15,0,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3B82F6" />
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="#BDC3C7"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Border" Property="Background" Value="#416D99" />
                                            <Setter Property="Foreground" Value="White"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Header" Value="{Binding DisplayName}"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- Szablon samego kontentu po prawej (widok wybranej bazy) -->
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Security Audit Report" FontSize="24" FontFamily="Segoe UI" FontWeight="Light" Foreground="#7F8C8D"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,20">
                                <TextBlock Text="Instance: " FontSize="18" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding ServerName}" FontSize="18" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#E74C3C"/>
                                <TextBlock Text="  |  Database: " FontSize="18" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#2C3E50" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding DatabaseName}" FontSize="18" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#2980B9"/>
                            </StackPanel>

                            <TabControl Grid.Row="2" Grid.RowSpan="2" Margin="0,0,0,0" Style="{StaticResource SectionTabControlStyle}">
                                <TabControl.ItemContainerStyle><Style TargetType="TabItem" BasedOn="{StaticResource SectionTabItemStyle}"/></TabControl.ItemContainerStyle>
                                <TabItem Header="Audit">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                                <Button Content="Run multiple"
                                                        Padding="15,8"
                                                        Background="#1F618D" Foreground="White" FontWeight="Bold"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="RunMultipleCategories_Click">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>

                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                                                <StackPanel x:Name="ResultsPanel">
                                    <Border Background="#F8F9F9" BorderBrush="#EAEDED" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                        <Expander IsExpanded="False" HorizontalContentAlignment="Stretch" Expanded="GeneralInfoExpander_Expanded">
                                            <Expander.Header>
                                                <Grid Margin="0,0,16,0" HorizontalAlignment="Stretch">
                                                    <TextBlock Text="General Information" FontSize="16" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="Loading data..." Foreground="#566573" FontStyle="Italic" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGeneralInfoLoading}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding GeneralInfoError}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GeneralInfoError}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding GeneralInfoError}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding GeneralInfoEntries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="260"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="#34495E" TextWrapping="Wrap"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#566573" TextWrapping="Wrap" Margin="10,0,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border Background="#F8F9F9" BorderBrush="#EAEDED" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                        <Expander IsExpanded="False" HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Grid Margin="0,0,16,0" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Maintenance and Integrity" FontSize="16" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center"/>

                                                    <Button Grid.Column="1" Content="Run" Click="MaintenanceIntegrityRun_Click" Padding="12,4" Margin="12,0,0,0" Background="#2980B9" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Setter Property="Content" Value="Run"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMaintenanceIntegrityRunning}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Content" Value="Running..."/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Expander.Header>

                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="Running scripts..." Foreground="#566573" FontStyle="Italic" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMaintenanceIntegrityRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding MaintenanceIntegrityError}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MaintenanceIntegrityError}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding MaintenanceIntegrityError}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding MaintenanceIntegrityResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                                    <Border HorizontalAlignment="Stretch" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8" Background="White">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ScriptName, TargetNullValue=[Unnamed script], FallbackValue=[Unnamed script]}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                                                    <Border Background="#E8F4FF" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="ℹ" FontSize="12" Margin="0,0,8,0" Foreground="#2B7CBF" VerticalAlignment="Top" Grid.Column="0"/>
                                                                            <TextBlock Text="{Binding Description}" FontStyle="Italic" FontSize="12" Foreground="#2B7CBF" TextWrapping="Wrap" Grid.Column="1" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource WidthMinusConverter}, ConverterParameter=40}"/>
                                                                        </Grid>
                                                                    </Border>

                                                                    <TextBlock Text="{Binding Error}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,6">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Error}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <!-- If script produced DataTable(s) show them using ScriptResultsControl; otherwise show textual rows -->
                                                                    <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding Tables}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <views:ScriptResultsControl Results="{Binding}" ScriptName="{Binding DataContext.ScriptName, RelativeSource={RelativeSource AncestorType=Border}}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                                            <!-- Show fix script when this result contains any Red rows and a fix is available -->
