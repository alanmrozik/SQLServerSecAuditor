                                        <GridViewColumn Header="Path" Width="320" DisplayMemberBinding="{Binding Path}"/>
                                        <GridViewColumn Header="Aktualny (Audit)" Width="300" DisplayMemberBinding="{Binding CurrentValue}"/>
                                        <GridViewColumn Header="" Width="40" DisplayMemberBinding="{Binding Marker}"/>
                                        <GridViewColumn Header="Snapshot" Width="300" DisplayMemberBinding="{Binding SnapshotValue}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
