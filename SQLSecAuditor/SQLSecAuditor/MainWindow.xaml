<Window x:Class="SqlSecAuditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SqlSecAuditor.Views"
        xmlns:conv="clr-namespace:SqlSecAuditor.Converters"
        Title="SQLSecAuditor" Height="800" Width="1000"
        Background="{StaticResource AppWindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:WidthMinusConverter x:Key="WidthMinusConverter" />
        <Style x:Key="ReportBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCDCDC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="SidebarTabItemStyle" TargetType="TabItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="15,0,15,10"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="#F8F8F8" 
                                BorderBrush="#C0C0C0" 
                                BorderThickness="1" 
                                CornerRadius="2">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              Margin="10,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E5E5" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#A0A0A0" />
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EEEEEE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumberButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCDCDC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Własny systemowy pasek tytułu (Window Chrome) -->
        <Grid Grid.Row="0" Background="{StaticResource AppHeaderBackgroundBrush}" Height="35">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tytuł aplikacji -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <!-- Można tu dodać logo/ikonkę, jeśli będzie -->
                <TextBlock Text="SQLServerSecAuditor" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Przyciski z kontrolkami okna systemowego (z obsługą w Code-Behind) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Width="45" FontSize="14" FontFamily="Consolas" Click="Minimize_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AppHeaderHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="[ ]" Width="45" FontSize="12" FontFamily="Consolas" Click="Maximize_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AppHeaderHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="X" Width="45" FontSize="14" FontFamily="Consolas" Click="Close_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E74C3C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <Menu Grid.Row="1" Background="#2C3E50" Foreground="White" BorderThickness="0" Padding="5,2" WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="_Plik" Padding="10,5">
                <MenuItem Header="_Połącz z nową bazą..." Command="{Binding ConnectNewDatabaseCommand}" Foreground="Black"/>
                <Separator/>
                <MenuItem Header="_Zakończ" Foreground="Black" Click="Close_Click"/>
            </MenuItem>
            <MenuItem Header="_Edycja" Padding="10,5"/>
            <MenuItem Header="_Widok" Padding="10,5"/>
            <MenuItem Header="P_omoc" Padding="10,5"/>
        </Menu>

        <Grid Grid.Row="2" Background="{StaticResource AppWindowBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="250"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Boczny panel jako nagłówek z przyciskiem z boku zamiast po prostu TabControl -->
            <Border x:Name="InstancesSidebar" Grid.Column="0" Background="{StaticResource AppHeaderHoverBrush}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Zbadane Instancje" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,10,0,20" HorizontalAlignment="Center"/>

                    <!-- Przycisk do połączeń bazy będzie tu dla wygody użytkownika (oprócz menu) -->
                    <Button Grid.Row="2" Content="+ Połącz z nową bazą" 
                            Command="{Binding ConnectNewDatabaseCommand}"
                            Background="#27AE60" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Padding="10" Cursor="Hand" Margin="0,10,0,10">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#34495E"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Taby -->
            <TabControl Grid.Column="0" Grid.ColumnSpan="3"
                Tag="{Binding ElementName=InstancesSidebar, Path=ActualWidth}"
                TabStripPlacement="Left" 
                Background="Transparent" 
                BorderThickness="0" 
                Padding="0"
                ItemsSource="{Binding Instances}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Boczna strefa zakładek "nakłada" się na nasz panel w tle -->
                            <StackPanel Grid.Column="0" IsItemsHost="True" Margin="0,50,0,80"/>

                            <Border Grid.Column="1" Background="{StaticResource AppPanelBackgroundBrush}" BorderBrush="{StaticResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="15" Padding="10">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Height" Value="45"/>
                        <Setter Property="Margin" Value="10,0,10,5"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Background="#2C3E50" BorderThickness="0" CornerRadius="4">
                                        <ContentPresenter x:Name="ContentSite"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          ContentSource="Header"
                                                          Margin="15,0,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#2980B9" />
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="#BDC3C7"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Border" Property="Background" Value="#3D566E" />
                                            <Setter Property="Foreground" Value="White"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Header" Value="{Binding DisplayName}"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- Szablon samego kontentu po prawej (widok wybranej bazy) -->
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Raport Audytu" FontSize="24" FontFamily="Segoe UI" FontWeight="Light" Foreground="#7F8C8D"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,20">
                                <TextBlock Text="Instancja: " FontSize="18" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding ServerName}" FontSize="18" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#E74C3C"/>
                                <TextBlock Text="  |  Baza: " FontSize="18" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#2C3E50" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding DatabaseName}" FontSize="18" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#2980B9"/>
                            </StackPanel>

                            <TabControl Grid.Row="2" Grid.RowSpan="2" Margin="0,0,0,0">
                                <TabItem Header="Audit">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                                            <StackPanel x:Name="ResultsPanel">
                                    <Border Background="#F8F9F9" BorderBrush="#EAEDED" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                        <Expander IsExpanded="False" HorizontalContentAlignment="Stretch" Expanded="GeneralInfoExpander_Expanded">
                                            <Expander.Header>
                                                <Grid Margin="0,0,16,0" HorizontalAlignment="Stretch">
                                                    <TextBlock Text="Informacje Ogólne" FontSize="16" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="Ładowanie danych..." Foreground="#566573" FontStyle="Italic" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGeneralInfoLoading}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding GeneralInfoError}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GeneralInfoError}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding GeneralInfoError}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding GeneralInfoEntries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="260"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" Foreground="#34495E" TextWrapping="Wrap"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#566573" TextWrapping="Wrap" Margin="10,0,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border Background="#F8F9F9" BorderBrush="#EAEDED" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                        <Expander IsExpanded="False" HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Grid Margin="0,0,16,0" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Utrzymanie i integralność" FontSize="16" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center"/>

                                                    <Button Grid.Column="1" Content="Uruchom" Click="MaintenanceIntegrityRun_Click" Padding="12,4" Margin="12,0,0,0" Background="#2980B9" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Setter Property="Content" Value="Uruchom"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMaintenanceIntegrityRunning}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Content" Value="Uruchamianie..."/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Expander.Header>

                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="Wykonywanie skryptów..." Foreground="#566573" FontStyle="Italic" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMaintenanceIntegrityRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding MaintenanceIntegrityError}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MaintenanceIntegrityError}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding MaintenanceIntegrityError}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding MaintenanceIntegrityResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                                    <Border HorizontalAlignment="Stretch" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8" Background="White">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ScriptName, TargetNullValue=[Brak nazwy skryptu], FallbackValue=[Brak nazwy skryptu]}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                                                    <Border Background="#E8F4FF" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="ℹ" FontSize="12" Margin="0,0,8,0" Foreground="#2B7CBF" VerticalAlignment="Top" Grid.Column="0"/>
                                                                            <TextBlock Text="{Binding Description}" FontStyle="Italic" FontSize="12" Foreground="#2B7CBF" TextWrapping="Wrap" Grid.Column="1" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource WidthMinusConverter}, ConverterParameter=40}"/>
                                                                        </Grid>
                                                                    </Border>

                                                                    <TextBlock Text="{Binding Error}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,6">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Error}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <!-- If script produced DataTable(s) show them using ScriptResultsControl; otherwise show textual rows -->
                                                                    <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding Tables}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <views:ScriptResultsControl Results="{Binding}" ScriptName="{Binding DataContext.ScriptName, RelativeSource={RelativeSource AncestorType=Border}}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border Background="#F8F9F9" BorderBrush="#EAEDED" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                        <Expander IsExpanded="False" HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Grid Margin="0,0,16,0" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Sieć i łączność" FontSize="16" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center"/>

                                                    <Button Grid.Column="1" Content="Uruchom" Click="NetworkConnectivityRun_Click" Padding="12,4" Margin="12,0,0,0" Background="#2980B9" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Setter Property="Content" Value="Uruchom"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNetworkConnectivityRunning}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Content" Value="Uruchamianie..."/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Expander.Header>

                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="Wykonywanie skryptów..." Foreground="#566573" FontStyle="Italic" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNetworkConnectivityRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding NetworkConnectivityError}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NetworkConnectivityError}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding NetworkConnectivityError}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding NetworkConnectivityResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                                    <Border HorizontalAlignment="Stretch" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8" Background="White">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ScriptName, TargetNullValue=[Brak nazwy skryptu], FallbackValue=[Brak nazwy skryptu]}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                                                    <Border Background="#E8F4FF" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
