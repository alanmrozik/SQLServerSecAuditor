                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighAvailabilityDisasterRecoveryRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding HighAvailabilityDisasterRecoveryError}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HighAvailabilityDisasterRecoveryError}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HighAvailabilityDisasterRecoveryError}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding HighAvailabilityDisasterRecoveryResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                                    <Border HorizontalAlignment="Stretch" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8" Background="White">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ScriptName, TargetNullValue=[Unnamed script], FallbackValue=[Unnamed script]}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                                                    <Border Background="#E8F4FF" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="ℹ" FontSize="12" Margin="0,0,8,0" Foreground="#2B7CBF" VerticalAlignment="Top" Grid.Column="0"/>
                                                                            <TextBlock Text="{Binding Description}" FontStyle="Italic" FontSize="12" Foreground="#2B7CBF" TextWrapping="Wrap" Grid.Column="1" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource WidthMinusConverter}, ConverterParameter=40}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Error}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,6">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Error}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding Tables}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <views:ScriptResultsControl Results="{Binding}" ScriptName="{Binding DataContext.ScriptName, RelativeSource={RelativeSource AncestorType=Border}}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <!-- Show fix script when this result contains any Red rows and a fix is available -->
                                                                    <Border Background="#F4F8FF" BorderBrush="#DDEEFF" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasAnyRed}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding FixScript}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding FixScript}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <StackPanel>
                                                                            <Grid Margin="0,0,0,6">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="Suggested remediation script:" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center" />
                                                                                <Button Grid.Column="1" Content="📋 Copy" Click="CopyFixScript_Click" Padding="8,4" Background="#2980B9" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand">
                                                                                    <Button.Resources>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="CornerRadius" Value="3"/>
                                                                                        </Style>
                                                                                    </Button.Resources>
                                                                                </Button>
                                                                            </Grid>
                                                                            <TextBox Text="{Binding FixScript}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Height="120"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                    <Border Background="#F8F9F9" BorderBrush="#EAEDED" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                        <Expander IsExpanded="False" HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Grid Margin="0,0,16,0" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Custom Queries" FontSize="16" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="+ Add query" Click="AddCustomQuery_Click" Padding="12,4" Margin="12,0,0,0" Background="#566573" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                                    <Button Grid.Column="2" Content="Run all" Click="RunCustomQueries_Click" Padding="12,4" Margin="8,0,0,0" Background="#2980B9" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="Add custom SQL queries to run against the selected instance. They are saved locally in your user profile." Foreground="#566573" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TextBlock Text="No custom queries have been saved." Foreground="#7F8C8D" FontStyle="Italic">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CustomQueries.Count, RelativeSource={RelativeSource AncestorType=Window}}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding DataContext.CustomQueries, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Run" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Expander}}" Click="RunCustomQuery_Click" Padding="10,3" Margin="8,0,0,0"/><Button Grid.Column="2" Content="Delete" Click="DeleteCustomQuery_Click" Padding="10,3" Margin="6,0,0,0" Foreground="#C0392B"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Running queries..." Foreground="#566573" FontStyle="Italic" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustomQueriesRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                <TextBlock Text="{Binding CustomQueriesError}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                <ItemsControl ItemsSource="{Binding CustomQueryResults}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8" Background="White"><StackPanel><TextBlock Text="{Binding ScriptName}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/><TextBlock Text="{Binding Error}" Foreground="#C0392B" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Tables}"><ItemsControl.ItemTemplate><DataTemplate><views:ScriptResultsControl Results="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                <Button Content="Save snapshot"
                                        Padding="15,8" 
                                        Background="#16A085" Foreground="White" FontWeight="Bold" 
                                        BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                                        Click="SaveSnapshot_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="Export PDF report"
                                        Padding="15,8" 
                                        Background="#2980B9" Foreground="White" FontWeight="Bold" 
                                        BorderThickness="0" Cursor="Hand"
                                        Click="ExportReport_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Scoring">
                        <Grid Margin="0,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="White" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Security Score" FontSize="18" FontWeight="SemiBold" Foreground="#34495E" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                        <Grid Width="220" Height="220">
                                            <Ellipse Stroke="#ECF0F1" StrokeThickness="14" Fill="Transparent"/>

                                            <Path StrokeThickness="14" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                <Path.Stroke>
                                                    <MultiBinding Converter="{StaticResource ScoreToBrushConverter}">
                                                        <!-- Use raw (signed) points for normalization so chart position reflects negatives correctly -->
                                                        <Binding Path="ScoringRawPoints"/>
                                                        <Binding Path="ScoringMinPoints"/>
                                                        <Binding Path="ScoringMaxPoints"/>
                                                    </MultiBinding>
                                                </Path.Stroke>
                                                <Path.Data>
                                                    <MultiBinding Converter="{StaticResource ScoreToArcConverter}">
                                                        <!-- Use raw (signed) points for arc normalization -->
                                                        <Binding Path="ScoringRawPoints"/>
                                                        <Binding Path="ScoringMinPoints"/>
                                                        <Binding Path="ScoringMaxPoints"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                    </MultiBinding>
                                                </Path.Data>
                                            </Path>

                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Show percent prominently in the center -->
                                                <TextBlock Text="{Binding ScoringPercentDisplay}" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding ScoringDisplay}" FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="White" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Breakdown" FontSize="18" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Green (+1)" Foreground="#27AE60" FontSize="14"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ScoringGreenCount}" Foreground="#27AE60" FontWeight="SemiBold" FontSize="14"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Yellow" Foreground="#F39C12" FontSize="14"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ScoringYellowCount}" Foreground="#F39C12" FontWeight="SemiBold" FontSize="14"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Red (-1)" Foreground="#E74C3C" FontSize="14"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ScoringRedCount}" Foreground="#E74C3C" FontWeight="SemiBold" FontSize="14"/>
                                        </Grid>

                                        <Border Background="#F8F9F9" BorderBrush="#E5E7E9" BorderThickness="1" CornerRadius="8" Padding="12">
                                            <TextBlock Text="The score uses the result colors: green = +1 point, red = -1 point. Yellow results do not change the score and require administrator review." TextWrapping="Wrap" Foreground="#566573"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1" Margin="0,12,0,0" Foreground="#7F8C8D"
                                       Text="Run categories in the Audit tab to update the score."/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </DataTemplate>
    </TabControl.ContentTemplate>
</TabControl>

                        <Border Grid.Column="2" Panel.ZIndex="5" Margin="15" Padding="28"
                                Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Instances.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Saved connections" FontSize="26" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="Select a server to open the connection window with its details, or create a new connection. Passwords are never stored."
                                               Margin="0,7,0,24" Foreground="#64748B" TextWrapping="Wrap"/>

                                    <TextBlock Text="No saved connections yet." Foreground="#94A3B8" FontStyle="Italic" Margin="0,0,0,16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SavedConnections.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding SavedConnections}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="270" MinHeight="150" Margin="0,0,14,14" Padding="16"
                                                        Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Button Command="{Binding DataContext.OpenSavedConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                                                HorizontalContentAlignment="Stretch" Cursor="Hand" Padding="0">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayLabel}" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A5F" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding AuthenticationLabel}" Margin="0,8,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
                                                                <TextBlock Text="Open connection details →" Margin="0,12,0,0" Foreground="#2563EB" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                                            <Button Content="Edit" Padding="10,4" Margin="0,0,7,0"
                                                                    Command="{Binding DataContext.EditSavedConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Delete" Padding="10,4" Foreground="#B91C1C" Click="DeleteSavedConnection_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ New connection" Width="160" Padding="14,9" HorizontalAlignment="Left"
                                            Command="{Binding ConnectNewDatabaseCommand}" Background="#27AE60" Foreground="White"
                                            FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- === TAB: SNAPSHOTS (globalny) === -->
                <TabItem Header="Snapshots">
                    <TabControl Style="{StaticResource SectionTabControlStyle}" Padding="18,0,0,0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem" BasedOn="{StaticResource SectionTabItemStyle}"/>
                        </TabControl.ItemContainerStyle>

                        <!-- Comparer -->
                        <TabItem Header="Compare">
                            <Border Background="{StaticResource AppPanelBackgroundBrush}"
                                    BorderBrush="{StaticResource AppAccentBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="15" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Snapshot Comparison" FontSize="18" FontWeight="Bold"
                                               Foreground="#2C3E50" Margin="0,0,0,16"/>

                                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="COMPARE CURRENT AUDIT WITH SNAPSHOT"
                                                Padding="14,9" Margin="0,0,10,8"
                                                Background="#8E44AD" Foreground="White" FontWeight="Bold"
                                                BorderThickness="0" Cursor="Hand"
                                                Click="CompareSnapshot_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="COMPARE TWO SNAPSHOTS"
                                                Padding="14,9" Margin="0,0,0,8"
                                                Background="#2980B9" Foreground="White" FontWeight="Bold"
                                                BorderThickness="0" Cursor="Hand"
                                                Click="CompareTwoSnapshots_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </WrapPanel>

                                    <TextBlock Grid.Row="2" Text="{Binding SnapshotComparisonSummary}"
                                               Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,10"
                                               TextWrapping="Wrap"/>

                                    <ListView Grid.Row="3" ItemsSource="{Binding SnapshotComparisonRows}"
                                              BorderBrush="#D5DBDB" BorderThickness="1" Background="White">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Path" Width="320" DisplayMemberBinding="{Binding Path}"/>
                                                <GridViewColumn Header="Value A" Width="280" DisplayMemberBinding="{Binding CurrentValue}"/>
                                                <GridViewColumn Header="" Width="40" DisplayMemberBinding="{Binding Marker}"/>
                                                <GridViewColumn Header="Value B" Width="280" DisplayMemberBinding="{Binding SnapshotValue}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- Viewer -->
                        <TabItem Header="Viewer">
                            <Border Background="{StaticResource AppPanelBackgroundBrush}"
                                    BorderBrush="{StaticResource AppAccentBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="15" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Snapshot Viewer" FontSize="18" FontWeight="Bold"
                                               Foreground="#2C3E50" Margin="0,0,0,16"/>

                                    <Button Grid.Row="1" Content="LOAD SNAPSHOT"
                                            HorizontalAlignment="Left"
                                            Padding="14,9" Margin="0,0,0,12"
                                            Background="#27AE60" Foreground="White" FontWeight="Bold"
                                            BorderThickness="0" Cursor="Hand"
                                            Click="LoadSnapshotViewer_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <TextBlock Grid.Row="2" Text="{Binding SnapshotViewerSummary}"
                                               Foreground="#2C3E50" FontWeight="SemiBold" Margin="0,0,0,10"
                                               TextWrapping="Wrap"/>

                                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding SnapshotViewerCategories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4"
                                                                Padding="10" Margin="0,0,0,10" Background="#F8F9F9">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                                                           Foreground="#2C3E50" Margin="0,0,0,8"/>
                                                                <TextBlock Text="{Binding Error}" Foreground="#C0392B"
                                                                           TextWrapping="Wrap" Margin="0,0,0,8">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Error}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <ItemsControl ItemsSource="{Binding Scripts}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="#E5E7E9" BorderThickness="1"
                                                                                    CornerRadius="4" Padding="8" Margin="0,0,0,8" Background="White">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding ScriptName}" FontWeight="SemiBold"
                                                                                               Foreground="#1F618D" Margin="0,0,0,6"/>
                                                                                    <TextBlock Text="{Binding Error}" Foreground="#C0392B"
                                                                                               TextWrapping="Wrap" Margin="0,0,0,6">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding Error}" Value="">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                    <ItemsControl ItemsSource="{Binding Tables}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <views:ScriptResultsControl Results="{Binding}" ScriptName="{Binding DataContext.ScriptName, RelativeSource={RelativeSource AncestorType=Border}}" />
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
